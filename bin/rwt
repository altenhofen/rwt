#!/usr/bin/env zsh
# Creates or selects a git worktree and opens it in a tmux window or split.
emulate -L zsh
setopt extended_glob

# Flat config keyed `section.key`. Global config loads first, then .rwt.toml overrides it.
typeset -A CFG
CFG=(
  agents.which ''
  agents.auto_open false
  agents.default ''
  worktrees.from HEAD
  tmux.default_split vertical
)

BRANCH='' BASE='' PLACEMENT='' AGENT='' INTERACTIVE=0

# Styling stays off unless stdout is a terminal and NO_COLOR is unset.
C_RESET='' C_BOLD='' C_DIM='' C_ACCENT='' C_OK='' C_ERR=''
setup_colors() {
  [[ -t 1 && -z ${NO_COLOR:-} ]] || return 0
  C_RESET='%f%b' C_BOLD='%B' C_DIM='%F{245}' C_ACCENT='%F{81}' C_OK='%F{114}' C_ERR='%F{203}'
}

# Escapes % so a value prints literally through print -P.
esc() {
  print -r -- ${1//\%/%%}
}

die() {
  local msg=${(j: :)@}
  print -P -u2 -- "${C_ERR}rwt${C_RESET} $(esc "$msg")"
  if (( INTERACTIVE )); then
    print -nP -u2 -- "  ${C_DIM}press any key to close${C_RESET}"
    read -rsk1
    print -u2
  fi
  exit 1
}

usage() {
  cat <<'EOF'
usage: rwt [-t|--to] <branch> [-f|--from <base>] [-w|-hs|-vs|-s] [-a|--agent <name>]
       rwt --interactive

  -w,  --window            open the worktree in a new tmux window
  -hs, --horizontal-split  split the current window horizontally
  -vs, --vertical-split    split the current window vertically
  -s,  --split             split using [tmux] default_split
  -a,  --agent <name>      start this agent in the new pane
  --interactive            prompt for each choice (used by the tmux plugin)
EOF
}

trim() {
  local s=$1
  s=${s##[[:space:]]#}
  s=${s%%[[:space:]]#}
  print -r -- $s
}

# Drops a trailing `# comment`, ignoring any `#` inside double quotes.
strip_comment() {
  local s=$1 out='' ch quoted=0 i
  for (( i = 1; i <= ${#s}; i++ )); do
    ch=${s[i]}
    [[ $ch == '"' ]] && (( quoted = !quoted ))
    [[ $ch == '#' ]] && (( ! quoted )) && break
    out+=$ch
  done
  print -r -- $out
}

# Reads the TOML subset rwt uses: [section], key = "string", key = bool, key = ["a", "b"].
load_config() {
  local file=$1 line section='' key value item
  local -a items out
  [[ -r $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=$(trim "$(strip_comment "$line")")
    [[ -n $line ]] || continue
    if [[ $line == \[*\] ]]; then
      section=${line#\[}
      section=$(trim "${section%\]}")
    elif [[ $line == *=* ]]; then
      key=$(trim "${line%%=*}")
      value=$(trim "${line#*=}")
      if [[ $value == \[*\] ]]; then
        value=${value#\[}
        value=${value%\]}
        items=(${(s:,:)value})
        out=()
        for item in $items; do
          item=$(trim "$item")
          item=${item#\"}
          item=${item%\"}
          [[ -n $item ]] && out+=$item
        done
        value=${(F)out}
      elif [[ $value == \"*\" ]]; then
        value=${value#\"}
        value=${value%\"}
      fi
      CFG[$section.$key]=$value
    fi
  done < "$file"
}

need() {
  [[ -n ${2:-} ]] || die "$1 needs a value"
}

set_placement() {
  [[ -z $PLACEMENT || $PLACEMENT == $1 ]] || die "choose one of -w, -hs, -vs, -s"
  PLACEMENT=$1
}

parse_args() {
  local -a positional
  while (( $# )); do
    case $1 in
      -t|--to) need "$1" "$2"; BRANCH=$2; shift ;;
      -f|--from) need "$1" "$2"; BASE=$2; shift ;;
      -a|--agent) need "$1" "$2"; AGENT=$2; shift ;;
      -w|--window) set_placement window ;;
      -hs|--horizontal-split) set_placement horizontal ;;
      -vs|--vertical-split) set_placement vertical ;;
      -s|--split) set_placement default ;;
      --interactive) INTERACTIVE=1 ;;
      -h|--help) usage; exit 0 ;;
      --) shift; positional+=("$@"); break ;;
      -*) die "unknown flag: $1" ;;
      *) positional+=("$1") ;;
    esac
    shift
  done

  if [[ -z $BRANCH ]] && (( $#positional )); then
    BRANCH=$positional[1]
    positional=("${(@)positional[2,-1]}")
  fi
  if [[ -z $BASE ]] && (( $#positional )); then
    BASE=$positional[1]
    positional=("${(@)positional[2,-1]}")
  fi
  (( $#positional == 0 )) || die "unexpected argument: $positional[1]"
}

require_repo() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"
}

branch_token() {
  local sample attempt
  for (( attempt = 1; attempt <= 32; attempt++ )); do
    sample=$(openssl rand -base64 6 2>/dev/null) || return 1
    if (( ${#sample} == 8 )) && [[ $sample != *[^A-Za-z0-9]* ]]; then
      print -r -- "$sample"
      return 0
    fi
  done
  return 1
}

resolve_branch_template() {
  local template=$1 token resolved=''
  command -v openssl >/dev/null 2>&1 || return 1
  while [[ $template == *'$'* ]]; do
    token=$(branch_token) || return 1
    resolved+="${template%%\$*}$token"
    template=${template#*\$}
  done
  print -r -- "$resolved$template"
}

main_worktree() {
  local -a lines=(${(f)"$(git worktree list --porcelain)"})
  print -r -- ${lines[1]#worktree }
}

# Prints the path of the worktree that already has $1 checked out, if any.
existing_worktree() {
  local branch=$1 line wt_path=''
  for line in ${(f)"$(git worktree list --porcelain)"}; do
    case $line in
      worktree\ *) wt_path=${line#worktree } ;;
      "branch refs/heads/$branch") print -r -- $wt_path; return 0 ;;
    esac
  done
  return 1
}

ensure_worktree() {
  local branch=$1 base=$2 root wt_path
  if wt_path=$(existing_worktree "$branch"); then
    print -r -- $wt_path
    return 0
  fi
  root=$(main_worktree)
  wt_path="${root:h}/${root:t}-worktrees/$branch"
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add -q "$wt_path" "$branch" >&2
  else
    git worktree add -q -b "$branch" "$wt_path" "$base" >&2
  fi || die "could not create worktree for $branch"
  print -r -- $wt_path
}

# Prints the agent command to run, or nothing when no agent applies.
agent_command() {
  local name=$1 entry
  local -a which=(${(f)CFG[agents.which]})
  if [[ -z $name ]]; then
    [[ $CFG[agents.auto_open] == true ]] || return 0
    name=$CFG[agents.default]
    [[ -n $name ]] || return 0
  fi
  if (( ! $#which )); then
    print -r -- $name
    return 0
  fi
  for entry in $which; do
    if [[ ${entry%% *} == "$name" ]]; then
      print -r -- $entry
      return 0
    fi
  done
  die "agent '$name' is not listed in [agents] which"
}

open_in_tmux() {
  local placement=$1 wt_path=$2 name=$3 cmd=$4 pane session
  case $placement in
    window)
      session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')
      pane=$(tmux new-window -t "$session:" -P -F '#{pane_id}' -c "$wt_path" -n "$name") ;;
    horizontal) pane=$(tmux split-window -t "$TMUX_PANE" -v -P -F '#{pane_id}' -c "$wt_path") ;;
    vertical) pane=$(tmux split-window -t "$TMUX_PANE" -h -P -F '#{pane_id}' -c "$wt_path") ;;
  esac || die "tmux could not open a $placement for $name"
  if [[ -n $cmd ]]; then
    tmux send-keys -t "$pane" "$cmd" Enter
  fi
}

show_worktrees() {
  local line wt_path='' branch
  for line in ${(f)"$(git worktree list --porcelain)"}; do
    case $line in
      worktree\ *) wt_path=${line#worktree } ;;
      branch\ refs/heads/*)
        branch=${line#branch refs/heads/}
        print -P -- "    ${C_OK}●${C_RESET} ${C_BOLD}$(esc "$branch")${C_RESET}  ${C_DIM}$(esc "${wt_path/#$HOME/~}")${C_RESET}" ;;
      detached) print -P -- "    ${C_DIM}○ detached  $(esc "${wt_path/#$HOME/~}")${C_RESET}" ;;
    esac
  done
}

# Prints a dim prompt and sets REPLY to the answer, or to $default when blank.
ask() {
  local label=$1 default=$2 reply
  print -nP -- "  ${C_ACCENT}›${C_RESET} $(esc "$label")"
  [[ -n $default ]] && print -nP -- " ${C_DIM}[$(esc "$default")]${C_RESET}"
  print -nP -- ": "
  read -r reply
  REPLY=${reply:-$default}
}

# Asks until the answer is blank (when $default is blank) or a number from 1 to $max.
pick() {
  local label=$1 max=$2 default=$3
  while true; do
    ask "$label" "$default"
    [[ -z $REPLY ]] && return 0
    if [[ $REPLY == <-> ]] && (( REPLY >= 1 && REPLY <= max )); then
      return 0
    fi
    print -P -- "    ${C_ERR}enter a number from 1 to $max${C_RESET}"
  done
}

# Prints each argument as a numbered option.
numbered() {
  local i=1 label
  for label in "$@"; do
    print -P -- "    ${C_ACCENT}${i}${C_RESET}  $(esc "$label")"
    (( i++ ))
  done
}

prompt_choices() {
  local -a which=(${(f)CFG[agents.which]})
  local -a placements=('new window' 'horizontal split' 'vertical split' 'default split' 'none')
  local -a placement_values=(window horizontal vertical default '')

  print -P ''
  print -P "  ${C_ACCENT}${C_BOLD}rwt${C_RESET}  ${C_DIM}new worktree${C_RESET}"
  print -P "  ${C_DIM}────────────────────────────────────${C_RESET}"
  print -P "  ${C_DIM}existing${C_RESET}"
  show_worktrees
  print -P ''

  ask 'branch' ''
  BRANCH=$REPLY
  ask 'from' "$CFG[worktrees.from]"
  BASE=$REPLY

  print -P ''
  print -P "  ${C_DIM}placement${C_RESET}"
  numbered "${placements[@]}"
  pick 'choice' $#placements 1
  PLACEMENT=${placement_values[REPLY]}

  if (( $#which )); then
    print -P ''
    print -P "  ${C_DIM}agent${C_RESET}"
    numbered "${which[@]}"
    pick 'agent' $#which ''
    [[ -n $REPLY ]] && AGENT=${which[REPLY]%% *}
  fi
}

run() {
  local wt_path cmd

  if [[ $PLACEMENT == default ]]; then
    PLACEMENT=$CFG[tmux.default_split]
  fi
  case $PLACEMENT in
    ''|window|horizontal|vertical) ;;
    *) die "[tmux] default_split must be horizontal or vertical" ;;
  esac
  if [[ -n $PLACEMENT && -z $TMUX ]]; then
    die "$PLACEMENT needs to run inside tmux"
  fi
  if [[ -n $AGENT && -z $PLACEMENT ]]; then
    die "-a needs a placement: -w, -hs, -vs or -s"
  fi

  cmd=$(agent_command "$AGENT") || exit 1
  wt_path=$(ensure_worktree "$BRANCH" "$BASE") || exit 1
  if (( INTERACTIVE )); then
    print -P -- "  ${C_OK}✓${C_RESET} ${C_BOLD}$(esc "$BRANCH")${C_RESET}  ${C_DIM}$(esc "${wt_path/#$HOME/~}")${C_RESET}"
  else
    print -r -- "$wt_path"
  fi

  [[ -n $PLACEMENT ]] || return 0
  open_in_tmux "$PLACEMENT" "$wt_path" "$BRANCH" "$cmd"
}

main() {
  setup_colors
  parse_args "$@"
  require_repo
  load_config "${XDG_CONFIG_HOME:-$HOME/.config}/rwt/rwt.toml"
  load_config "$(git rev-parse --show-toplevel)/.rwt.toml"
  if (( INTERACTIVE )); then
    prompt_choices
  fi
  [[ -n $BRANCH ]] || die "a branch name is required (see rwt --help)"
  if [[ $BRANCH == *'$'* ]]; then
    BRANCH=$(resolve_branch_template "$BRANCH") || die "could not generate a branch token"
  fi
  BASE=${BASE:-$CFG[worktrees.from]}
  run
}

main "$@"
